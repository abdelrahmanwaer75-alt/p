ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./backend/data/vidora_dev.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=vidora-api
JWT_AUDIENCE=vidora-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
DOWNLOAD_DIRECTORY=backend/data/media
AUTO_CREATE_DB=true

# Production example:
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://vidora:change-me@postgres:5432/vidora
# JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
# AUTO_CREATE_DB=false
