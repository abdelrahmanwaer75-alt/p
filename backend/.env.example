ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./backend/data/vidora_dev.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=vidora-api
JWT_AUDIENCE=vidora-client
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=60
ANALYZER_RATE_LIMIT_PER_MINUTE=30
DOWNLOAD_RATE_LIMIT_PER_MINUTE=20
CORS_ALLOW_CREDENTIALS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
DOWNLOAD_DIRECTORY=backend/data/media
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
AUTO_CREATE_DB=true
WORKER_READY_FILE=/tmp/vidora-worker.ready

# Production example:
# ENVIRONMENT=production
# POSTGRES_USER=<set-in-secret-store>
# POSTGRES_PASSWORD=<set-in-secret-store>
# POSTGRES_DB=vidora
# DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
# REDIS_URL=redis://<shared-redis-host>:6379/0
# DOWNLOAD_DIRECTORY=/app/data/media
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800
# AUTO_CREATE_DB=false
